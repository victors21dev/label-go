generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(uuid())
  name     String
  username String     @unique
  password String
  imageUrl String?
  email    String     @unique
  role     Role       @default(USER)
  status   UserStatus @default(UNAUTHORIZED)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labelGenerations LabelGeneration[]
}

model Sector {
  id   String @id @default(uuid())
  name String @unique

  coordinatorName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labelGenerations LabelGeneration[]
  users            User[]
}

model Printer {
  id    String @id @default(uuid())
  brand String
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labelGenerations LabelGeneration[]
}

model LabelModel {
  id String @id @default(uuid())

  name     String
  widthMm  Float
  heightMm Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labelGenerations LabelGeneration[]
}

model LabelGeneration {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  sector   Sector @relation(fields: [sectorId], references: [id])
  sectorId String

  labelModel   LabelModel @relation(fields: [labelModelId], references: [id])
  labelModelId String

  printer   Printer @relation(fields: [printerId], references: [id])
  printerId String

  quantity Int
  date     DateTime

  justification String

  status LabelStatus @default(GENERATED)

  metadata Json?

  createdAt DateTime @default(now())
}

enum LabelStatus {
  GENERATED
  CANCELED
}

enum Role {
  USER
  ADMIN
}

enum TypeOfMeal {
  BREAKFAST
  LUNCH
  DINNER
}

enum UserStatus {
  AUTHORIZED
  UNAUTHORIZED
}
